# Copy this file to .env and fill in your values
# NEVER commit the real .env to git

PORT=5000

# Generate a strong random secret:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_your_strong_random_secret_here

# Optional: set to 'production' on the server
NODE_ENV=production

# Google Gemini API Key — get one free at https://aistudio.google.com/app/apikey
# When set, PDF uploads use Gemini Vision (extracts image-based questions too).
# If not set, falls back to the built-in coordinate/text parser.
GEMINI_API_KEY=your_gemini_api_key_here

# ── Email (SMTP) — for OTP password reset ────────────────────────────
# Gmail: go to myaccount.google.com/apppasswords → generate App Password
# Set EMAIL_USER and EMAIL_PASS, then restart the server.
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_char_app_password
EMAIL_FROM=SmartExam <your_email@gmail.com>

# Database path — set this on Railway to a persistent volume mount path
# e.g. /data/exam_system.db  (create a Railway Volume mounted at /data)
# Leave unset to use the default ./exam_system.db in the project folder
# DATABASE_PATH=/data/exam_system.db
